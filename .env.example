# Tempik API
# Optional. Tempik (tempik.neroism.web.id) doesn't require authentication.
# You can leave this as 'dummy' or any value.
MAILSTACK_API_KEY=dummy

# 9router dashboard
# Accepts full URLs. Examples:
# DASHBOARD_URL=http://localhost:20128
# DASHBOARD_URL=http://192.168.1.100:20128
DASHBOARD_URL=http://localhost:20128
DASHBOARD_PASSWORD=change-me

# AWS/Kiro signup
# Keep this as the public profile entrypoint for fresh registrations.
KIRO_SIGNUP_URL=https://profile.aws.amazon.com

# Browser
HEADLESS=false
VIEWPORT_WIDTH=870
VIEWPORT_HEIGHT=706

# Speed profile for all artificial delays (typing, pauses, mouse movement).
# 1 = original/slowest, 0.3 = default, 0.2 = fastest.
# Lower is faster; too low increases bot-check risk.
SPEED=0.3

# Verification polling
VERIFICATION_TIMEOUT_MS=120000
VERIFICATION_POLL_INTERVAL_MS=5000

# Logging and debug artifacts
DEBUG=false
SCREENSHOT_ON_ERROR=true
